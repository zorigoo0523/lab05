{
  "info": {
    "name": "Lab05 — server.js-ийн согог илрүүлэгч тест",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Lab05 — Хичээлд бүртгүүлэх API-ийн тестийн багц. baseUrl нь collection variable."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "B1. Нэг оюутан нэг хичээлд ДАВХАР бүртгэгдэж болохгүй",
      "item": [
        {
          "name": "Setup: оюутан b1-stu",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Setup: оюутан b1-stu → 200 OK\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().result).to.eql(\"OK\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"active\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/students/b1-stu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "b1-stu"
              ]
            }
          }
        },
        {
