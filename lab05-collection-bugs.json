              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"B1 — ижил бүртгэлийг дахин 201-ээр хүлээн авч болохгүй\", function () { pm.expect(pm.response.code).to.not.eql(201); });"
